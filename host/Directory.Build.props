<Project>

  <!-- Configuración común a todos los proyectos del host. La versión de NexScreen se define acá
       y la usan el instalador y los releases (el workflow la sobrescribe con el tag vX.Y.Z). -->
  <PropertyGroup>
    <Version>0.7.0</Version>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Solo los recursos en español de .NET (evita carpetas de/fr/ja... en el instalador). -->
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Company>NexScreen</Company>
    <Product>NexScreen</Product>
    <Copyright>Copyright (c) 2026 Alex Pérez Argomedo</Copyright>
    <!-- Sin el hash del commit: todos los binarios de un release llevan exactamente la misma versión
         (SignPath exige un nombre y una versión de producto coherentes). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

</Project>
